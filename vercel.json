{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && npm run check",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    { "source": "/essays", "destination": "/#reading", "permanent": false },
    { "source": "/essays/", "destination": "/#reading", "permanent": false },
    { "source": "/follow", "destination": "/about/#follow", "permanent": true },
    { "source": "/follow/", "destination": "/about/#follow", "permanent": true }
  ]
}
